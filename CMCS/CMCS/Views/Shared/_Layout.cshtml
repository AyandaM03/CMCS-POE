<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMCS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CMCS.styles.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">CMCS</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- LEFT SIDE MENU -->
                    <ul class="navbar-nav me-auto">

                        <!-- Login + Register -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Register">Register</a>
                        </li>

                        <!-- Lecturer Section -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
                               data-bs-toggle="dropdown">Lecturer</a>

                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-controller="Lecturer" asp-action="Index">
                                        Submit Claim
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Claims" asp-action="Track">
                                        Track My Claims
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Coordinator -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Coordinator" asp-action="Index">
                                Project Coordinator
                            </a>
                        </li>

                        <!-- Manager -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Manager" asp-action="Index">
                                Project Manager
                            </a>
                        </li>

                        <!-- HR -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
                               data-bs-toggle="dropdown">HR</a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="LecturerManagement" asp-action="Index">
                                        Manage Lecturers
                                    </a>
                                </li>
                                  <li class="nav-item">
                                      <a class="nav-link text-dark" asp-controller="HR" asp-action="Index">HR Dashboard</a>
                                  </li>
                            </ul>
                        </li>

                    </ul>

                    <!-- RIGHT SIDE MENU -->
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-danger fw-bold" asp-controller="Auth" asp-action="Logout">
                                Logout
                            </a>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-auto bg-light text-center py-3 border-top">
        <div>
            &copy; 2025 - CMCS -
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

