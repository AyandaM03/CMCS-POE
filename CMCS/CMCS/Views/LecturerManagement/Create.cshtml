@model CMCS.Models.Lecturer

<h2>Create Lecturer</h2>

<form method="post">
    <div class="mb-3">
        <label>Name:</label>
        <input class="form-control" asp-for="Name" />
    </div>

    <div class="mb-3">
        <label>Email:</label>
        <input class="form-control" asp-for="Email" />
    </div>

    <button class="btn btn-primary">Create</button>
</form>
