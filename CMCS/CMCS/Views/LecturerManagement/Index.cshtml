@model IEnumerable<CMCS.Models.Lecturer>
@{
    ViewData["Title"] = "Manage Lecturers";
}

<h2>Lecturer Management</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No lecturers available.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-light">
                <tr>
                    <th>LecturerID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td>@l.LecturerID</td>
                        <td>@l.Name</td>
                        <td>@l.Email</td>
                        <td>
                            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@l.LecturerID">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
