@model IEnumerable<CMCS.Models.Lecturer>

<h2>Lecturer Management</h2>

<a class="btn btn-primary mb-3" asp-action="Create">Add Lecturer</a>

@if (!Model.Any())
{
    <div class="alert alert-info">No lecturers found.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Edit</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var l in Model)
            {
                <tr>
                    <td>@l.Name</td>
                    <td>@l.Email</td>

                    <td>
                        <a class="btn btn-sm btn-warning"
                           asp-action="Edit"
                           asp-route-id="@l.LecturerID">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
