@model IEnumerable<CMCS.Models.Claim>

@{
    ViewData["Title"] = "Manager Approval – Pre-Approved Claims";
}

<h2>Manager Dashboard — Claims Awaiting Final Approval</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No claims are currently awaiting final approval.
    </div>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Claim ID</th>
                <th>Lecturer</th>
                <th>Hours</th>
                <th>Rate</th>
                <th>Total</th>
                <th>Document</th>
                <th>Notes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.ClaimId</td>
                    <td>@c.LecturerName</td>
                    <td>@c.HoursWorked</td>
                    <td>@c.HourlyRate</td>
                    <td>@(c.HoursWorked* c.HourlyRate)</td>
                    <td>
                        @if (!string.IsNullOrEmpty(c.SupportingDocument))
                        {
                            <a href="~/uploads/@c.SupportingDocument" target="_blank" class="btn btn-sm btn-secondary">View</a>
                        }
                        else
                        {

                            <span>No File</span>
                        }
                    </td>

                    <td>@c.Notes</td>

                    <td>
                        <form asp-action="UpdateStatus" asp-controller="Manager" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@c.ClaimId" />
                            <input type="hidden" name="status" value="Approved" />
                            <button class="btn btn-success btn-sm">Approve</button>
                        </form>

                        <form asp-action="UpdateStatus" asp-controller="Manager" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@c.ClaimId" />
                            <input type="hidden" name="status" value="Rejected" />
                            <button class="btn btn-danger btn-sm">Reject</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

