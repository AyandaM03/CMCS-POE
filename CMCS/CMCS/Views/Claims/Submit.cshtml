@model CMCS.Models.Claim
@{
    ViewData["Title"] = "Submit Claim";
}

<div class="container mt-5">
    <h2 class="text-primary fw-bold mb-4">Submit Monthly Claim</h2>

    <form asp-action="Submit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Lecturer Name</label>
            <input asp-for="LecturerName" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Hours Worked</label>
            <input asp-for="HoursWorked" id="hours" type="number" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Hourly Rate (R)</label>
            <input asp-for="HourlyRate" id="rate" type="number" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Total Amount (Auto-Calculated)</label>
            <input id="total" type="text" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Upload Supporting Document</label>
            <input asp-for="SupportingDocument" type="file" class="form-control" />
        </div>

        <button class="btn btn-primary w-100" id="submitBtn" disabled>Submit Claim</button>
    </form>
</div>

<script>
    function updateTotal() {
        let hours = parseFloat(document.getElementById("hours").value) || 0;
        let rate = parseFloat(document.getElementById("rate").value) || 0;

        let total = hours * rate;
        document.getElementById("total").value = "R " + total.toFixed(2);

        document.getElementById("submitBtn").disabled = (hours <= 0 || rate <= 0);
    }

    document.getElementById("hours").addEventListener("input", updateTotal);
    document.getElementById("rate").addEventListener("input", updateTotal);
</script>

