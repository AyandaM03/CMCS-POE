@model CMCS.Models.Claim
@{
    ViewData["Title"] = "Submit Claim";
}

<h2 class="mb-4">Submit a Claim</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<form asp-action="Submit" method="post" enctype="multipart/form-data" class="p-4 shadow rounded bg-white">

    <div class="mb-3">
        <label class="form-label">Lecturer Name</label>
        <input asp-for="LecturerName" class="form-control" />
        <span asp-validation-for="LecturerName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Hours Worked</label>
        <input asp-for="HoursWorked" type="number" step="0.1" class="form-control calc-field" />
        <span asp-validation-for="HoursWorked" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Hourly Rate (R)</label>
        <input asp-for="HourlyRate" type="number" step="0.1" class="form-control calc-field" />
        <span asp-validation-for="HourlyRate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Total Amount (Auto Calculated)</label>
        <input id="totalAmount" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Notes</label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Supporting Document</label>
        <input type="file" class="form-control" name="file" />
    </div>

    <button type="submit" class="btn btn-primary w-100 mb-3">Submit Claim</button>

    <a class="btn btn-outline-secondary w-100" asp-controller="Claims" asp-action="Track">Track My Claims</a>

</form>

@section Scripts {
    <script>
        function calculate() {
            let hours = parseFloat(document.getElementById("HoursWorked").value) || 0;
            let rate = parseFloat(document.getElementById("HourlyRate").value) || 0;

            document.getElementById("totalAmount").value = "R " + (hours * rate).toFixed(2);
        }

        document.querySelectorAll(".calc-field").forEach(item => {
            item.addEventListener("input", calculate);
        });

        calculate();
    </script>
}
