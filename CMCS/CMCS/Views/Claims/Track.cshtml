@model IEnumerable<CMCS.Models.Claim>

@functions {
    string GetStatusBadge(string status)
    {
        return status switch
        {
            "Pending" => "badge bg-warning text-dark",
            "PreApproved" => "badge bg-primary",
            "Approved" => "badge bg-success",
            "Rejected" => "badge bg-danger",
            _ => "badge bg-secondary"
        };
    }
}

<h2 class="mb-4">My Claims</h2>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Lecturer Name</th>
            <th>Hours Worked</th>
            <th>Hourly Rate</th>
            <th>Total Amount</th>
            <th>Status</th>
            <th>Uploaded Document</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LecturerName</td>
                <td>@item.HoursWorked</td>
                <td>@item.HourlyRate</td>
                <td>@item.TotalAmount</td>
                <td>
                    <span class="@GetStatusBadge(item.Status)">
                        @item.Status
                    </span>
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.SupportingDocument))
                    {
                        <a href="~/uploads/@item.SupportingDocument" target="_blank">View</a>
                    }
                    else
                    {
                        <em>No file</em>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

