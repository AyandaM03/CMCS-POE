@model IEnumerable<CMCS.Models.Claim>

@{
    ViewData["Title"] = "Track My Claims";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h1 class="fw-bold text-primary">Track My Claims</h1>
        <p class="text-muted">Monitor the progress of your submitted claims in real-time.</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center my-5" role="alert">
            <h5 class="mb-0">No claims found.</h5>
            <p class="text-muted">You haven’t submitted any claims yet.</p>
        </div>
    }
    else
    {
        <div class="card shadow border-0 rounded-4">
            <div class="card-body p-4">
                <table class="table table-hover align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th>Claim ID</th>
                            <th>Hours</th>
                            <th>Total (R)</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>@c.ClaimId</td>
                                <td>@c.HoursWorked</td>
                                <td class="fw-semibold text-success">@c.TotalAmount.ToString("C0")</td>
                                <td>
                                    <span class="badge 
                                        @(c.Status == "Approved" ? "bg-success" :
                                          c.Status == "Rejected" ? "bg-danger" :
                                          c.Status == "PreApproved" ? "bg-info text-dark" :
                                          "bg-warning text-dark")">
                                        @c.Status
                                    </span>
                                </td>
                                <td>@c.SubmittedDate.ToShortDateString()</td>
                                <td>
                                    @if (c.Status == "Pending")
                                    {
                                        <button class="btn btn-sm btn-outline-warning">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger">Cancel</button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    body {
        background-color: #f7f9fb;
    }
    h1 {
        font-family: 'Segoe UI', sans-serif;
    }
    .table-hover tbody tr:hover {
        background-color: #eef6ff;
        transition: 0.2s;
    }
</style>

