@model IEnumerable<CMCS.Models.Claim>

<h2>My Submitted Claims</h2>

@if (Model == null || !Model.Any())
{
    <p>You have not submitted any claims yet.</p>
}
else
{
    <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Total (R)</th>
                <th>Status</th>
                <th>Submitted Date</th>
                <th>Document</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var claim in Model)
            {
                <tr>
                    <td>@claim.ClaimId</td>
                    <td>R @claim.TotalAmount</td>
                    <td>@claim.Status</td>
                    <td>@claim.SubmittedDate.ToString("yyyy-MM-dd HH:mm")</td>

                    <td>
                        @if (!string.IsNullOrEmpty(claim.SupportingDocument))
                        {
                            <a href="~/uploads/@claim.SupportingDocument" class="btn btn-secondary btn-sm" target="_blank">
                                View
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}


