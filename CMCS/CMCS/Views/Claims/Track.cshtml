@model IEnumerable<CMCS.Models.Claim>

@{
    ViewData["Title"] = "Track My Claims";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary display-6">Track My Claims</h1>
        <p class="text-muted">Monitor your claim’s progress from submission to final approval.</p>
    </div>

  
    <div class="card shadow border-0 rounded-4">
        <div class="card-body p-4">
            <table class="table table-hover align-middle text-center">
                <thead class="table-primary">
                    <tr>
                        <th>Claim ID</th>
                        <th>Hours</th>
                        <th>Total (R)</th>
                        <th>Status</th>
                        <th>Progress</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        string progressClass = c.Status switch
                        {
                            "Pending" => "25",
                            "PreApproved" => "50",
                            "Approved" => "100",
                            "Rejected" => "0",
                            _ => "0"
                        };

                        string progressColor = c.Status switch
                        {
                            "Pending" => "bg-warning",
                            "PreApproved" => "bg-info",
                            "Approved" => "bg-success",
                            "Rejected" => "bg-danger",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td>@c.ClaimId</td>
                            <td>@c.HoursWorked</td>
                            <td>@c.TotalAmount.ToString("C0")</td>
                            <td>
                                <span class="badge
                                        @(c.Status == "Approved" ? "bg-success" :
                                                                            c.Status == "Rejected" ? "bg-danger" :
                                                                            c.Status == "PreApproved" ? "bg-info text-dark" :
                                                                            "bg-warning text-dark")">
                                @c.Status
                            </span>
                        </td>
                        <td style="width: 200px;">
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar @progressColor" role="progressbar" style="width:@progressClass%"
                                     aria-valuenow="@progressClass" aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>
                        </td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-controller="Lecturer">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-controller="Lecturer" asp-route-id="@c.ClaimId">Cancel</a>
                        </td>
                    </tr>
                                        }
                </tbody>
            </table>
        </div>
    </div>

</div>

<style>
    body {
        background-color: #f7f9fb;
    }

    .progress {
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-bar {
        transition: width 0.5s ease-in-out;
    }

    .table-hover tbody tr:hover {
        background-color: #e9f5ff;
        transition: 0.3s ease;
    }
</style>

