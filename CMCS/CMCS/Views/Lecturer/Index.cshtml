@model CMCS.Models.Claim

@{
    ViewData["Title"] = "Submit Claim";
}

<h2>Submit New Claim</h2>

<form method="post">
    <div class="mb-3">
        <label>Hours Worked:</label>
        <input type="number" asp-for="HoursWorked" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Hourly Rate:</label>
        <input type="number" step="0.01" asp-for="HourlyRate" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Notes:</label>
        <textarea asp-for="Status" class="form-control"></textarea>
    </div>

    <label>Upload Document:</label>
    <input type="file" name="Document" /><br /><br />

    <button type="submit" class="btn btn-primary">Submit Claim</button>
</form>

