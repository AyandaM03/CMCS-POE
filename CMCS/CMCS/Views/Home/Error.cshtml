@{
    ViewData["Title"] = "Oops! Something went wrong";
}

<div class="container text-center py-5">
    <h1 class="display-5 text-danger mb-4"><i class="bi bi-exclamation-triangle-fill"></i> An Error Occurred</h1>
    <p class="lead text-muted">We’re sorry — something unexpected happened. Please try again later or contact support if the issue persists.</p>
    <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index">Back to Home</a>
</div>

<style>
    body {
        background-color: #f8fafc;
    }

    .container {
        max-width: 700px;
    }

    h1 {
        font-weight: 600;
    }
</style>
